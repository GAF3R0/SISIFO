# =============================================================
# Sisifo Agent Server — Variables de entorno
# Copia este archivo como .env y configura los valores reales
# NUNCA subas el archivo .env al repositorio
# =============================================================

# Restricción de orígenes CORS (producción: especificar dominio o IP de la app)
ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Puerto del servidor (default 8000)
PORT=8000

# Nivel de logs (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
